---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { allTags, formatDate, getAllPosts } from '../../lib/posts';
import { postUrl, withBase } from '../../lib/urls';
import '../../styles/content.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: tag.name },
    props: {
      tag: tag.name,
      posts: posts.filter((post) => post.data.tags.includes(tag.name)),
    },
  }));
}

const { tag, posts } = Astro.props;
const title = `标签：${tag}`;
---

<BaseLayout title={title} description={`${SITE.title} 中所有标记为「${tag}」的笔记。`}>
  <section class="page-hero">
    <div>
      <p class="page-hero__kicker mono">TAG / FIELD NOTES</p>
      <h1 class="page-hero__title">{tag}</h1>
    </div>
    <aside class="page-hero__aside">
      <strong>{posts.length} 篇相关笔记</strong>
      <p>同一片地形上的不同入口。也可以回到完整归档，按时间重新走一遍。</p>
      <p style="margin-top: 18px;">
        <a class="text-link" href={withBase('archive/')}>全部归档 <span aria-hidden="true">↗</span></a>
      </p>
    </aside>
  </section>

  <div class="page-content">
    <div class="archive-list">
      {posts.map((post) => {
        const date = new Date(post.data.date);
        return (
          <a class="archive-item" href={postUrl(post.id)}>
            <time class="archive-item__date" datetime={date.toISOString()}>
              {formatDate(date, 'short')}
            </time>
            <span class="archive-item__title">{post.data.title}</span>
            <span class="archive-item__arrow" aria-hidden="true">↗</span>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
