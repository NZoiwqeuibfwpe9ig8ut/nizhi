---
import { render } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import { formatDate, readingMinutes, type Post } from '../lib/posts';
import { assetUrl, postUrl, tagUrl, withBase } from '../lib/urls';
import '../styles/content.css';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
  noteNumber: number;
}

const { post, headings, newer, older, noteNumber } = Astro.props;
const noteCode = String(noteNumber).padStart(3, '0');
const isRasterCover = post.data.cover ? /\.(png|jpe?g|webp|avif)$/i.test(post.data.cover) : false;
const socialImage = isRasterCover ? post.data.cover : 'og.png';
const { Content } = await render(post);
const cover = assetUrl(post.data.cover);
const coverAlt = post.data.coverAlt ?? `${post.data.title} 的抽象封面`;
const date = new Date(post.data.date);
const updated = post.data.updated ? new Date(post.data.updated) : null;
const minutes = readingMinutes(post.body);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const signatureDate = formatDate(date);
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={socialImage}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={updated?.toISOString()}
>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress__bar"></div>
  </div>

  <article class="post" itemscope itemtype="https://schema.org/BlogPosting">
    <header class="post-header">
      <div class="post-header__meta">
        <span class="signal-dot" aria-hidden="true"></span>
        <span>FIELD NOTE / {noteCode}</span>
        <time datetime={date.toISOString()} itemprop="datePublished">{formatDate(date)}</time>
        <span>{minutes} MIN READ</span>
      </div>

      <div class="post-header__layout">
        <div>
          <h1 class="post-title" itemprop="headline">{post.data.title}</h1>
          <p class="post-deck" itemprop="description">{post.data.excerpt}</p>
        </div>

        <aside class="post-header__aside" aria-label="文章信息">
          <div class="post-fact">
            <span>最早写于</span>
            <span><time datetime={date.toISOString()}>{formatDate(date, 'short')}</time></span>
          </div>
          <div class="post-fact">
            <span>阅读时间</span>
            <span>{minutes} 分钟</span>
          </div>
          {
            updated && (
              <div class="post-fact">
                <span>最后修订</span>
                <span><time datetime={updated.toISOString()}>{formatDate(updated, 'short')}</time></span>
              </div>
            )
          }
          <div class="post-fact">
            <span>位置</span>
            <span>{SITE.coordinates}</span>
          </div>
          <div class="post-tags" aria-label="标签">
            {post.data.tags.map((tag) => <a class="tag" href={tagUrl(tag)}>{tag}</a>)}
          </div>
        </aside>
      </div>
    </header>

    {
      cover && (
        <figure class="post-cover">
          <div class="post-cover__frame">
            <img
              src={cover}
              alt={coverAlt}
              width="1200"
              height="470"
              decoding="async"
            />
          </div>
          <figcaption class="post-cover__caption">
            <span>FIG. A — {post.data.title}</span>
            <span>INLAND / {date.getFullYear()}</span>
          </figcaption>
        </figure>
      )
    }

    <div class="post-layout">
      <aside class="post-aside">
        <a class="post-aside__back" href={withBase('archive/')}>← 返回归档</a>

        {
          toc.length > 0 && (
            <div class="post-aside__block post-aside__block--toc">
              <p class="post-aside__label">本篇目录</p>
              <nav class="toc" aria-label="文章目录">
                {toc.map((heading) => (
                  <a href={`#${heading.slug}`} data-depth={heading.depth}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </div>
          )
        }

        <div class="post-aside__block post-aside__block--meta">
          <p class="post-aside__label">FIELD NOTE / {noteCode}</p>
          <p class="post-aside__value">
            {signatureDate}
            <br />
            {minutes} min read
          </p>
        </div>
      </aside>

      <div class="prose" itemprop="articleBody">
        <Content />

        <footer class="post-end">
          <p class="post-end__mark">END OF FIELD NOTE</p>
          <p class="post-end__signature">— {SITE.author}</p>
          <p class="post-end__note">
            如果这篇笔记让你想起某个地方、某本书或某个未完成的想法，欢迎写信告诉我。
            这里没有评论区，只有一条更慢的回信路径。
          </p>

          <nav class="post-pagination" aria-label="前后文章">
            {
              newer ? (
                <a class="post-pagination__link" href={postUrl(newer.id)}>
                  <span class="post-pagination__label">更新一篇 / NEWER</span>
                  <span class="post-pagination__title">{newer.data.title}</span>
                </a>
              ) : (
                <span class="post-pagination__link" aria-hidden="true">
                  <span class="post-pagination__label">已是最近</span>
                  <span class="post-pagination__title">—</span>
                </span>
              )
            }
            {
              older ? (
                <a class="post-pagination__link" href={postUrl(older.id)}>
                  <span class="post-pagination__label">更早一篇 / OLDER</span>
                  <span class="post-pagination__title">{older.data.title}</span>
                </a>
              ) : (
                <span class="post-pagination__link" aria-hidden="true">
                  <span class="post-pagination__label">回到起点</span>
                  <span class="post-pagination__title">—</span>
                </span>
              )
            }
          </nav>
        </footer>
      </div>

      <span aria-hidden="true"></span>
    </div>
  </article>
</BaseLayout>
