---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostRow from '../components/PostRow.astro';
import { SITE } from '../config';
import { PROJECTS, INTERNSHIPS, LEADERSHIP } from '../data/profile';
import { getAllPosts } from '../lib/posts';
import { postUrl, withBase } from '../lib/urls';
import '../styles/home.css';

const posts = await getAllPosts();
const latest = posts.slice(0, 5);
const year = new Date().getFullYear();
const issue = String(year - Number(SITE.since) + 1).padStart(3, '0');
const monthLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  timeZone: 'Asia/Shanghai',
})
  .format(new Date())
  .replace(/\//g, ' / ');
---

<BaseLayout
  title={undefined}
  description={SITE.description}
  overlayHeader={true}
  mainClass="home-main"
>
  <Hero />

  <div class="field-strip" aria-label="本站主题">
    <span class="field-strip__item"><span>01</span> 助农 / RURAL</span>
    <span class="field-strip__item"><span>02</span> 运营 / OPERATIONS</span>
    <span class="field-strip__item"><span>03</span> 组织 / ORGANIZING</span>
    <span class="field-strip__item"><span>04</span> 财务 / FINANCE</span>
    <span class="field-strip__item">ISSUE {issue} / {year}</span>
  </div>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="manifesto__index mono">
      FIELD NOTE 000
      <span>定位 / ORIENTATION</span>
    </div>

    <h2 class="manifesto__statement" id="manifesto-title">
      把每一次项目、实习和活动，当作理解真实世界的<em>现场</em>。
    </h2>

    <aside class="manifesto__aside">
      <p>
        我是倪志，财务管理本科在读。在数字和流程里训练，也在助农项目、红色宣讲和学生组织里
        练习把目标拆开、把现场走完。
      </p>
      <p>
        这里收录实践复盘、运营观察和阅读笔记。所有文章以 Markdown 保存，首页的 3D 地形是渐进增强：
        关掉它，阅读依然完整。
      </p>
      <p class="signature">倪志 / 重庆 · CHONGQING</p>
    </aside>
  </section>

  <section class="practice-section" id="practice" aria-labelledby="practice-title">
    <div class="section-heading">
      <span class="section-heading__index">01 / SELECTED PRACTICE</span>
      <h2 class="section-heading__title" id="practice-title">在真实世界里，让结果发生</h2>
      <a class="section-heading__link" href={withBase('about/')}>完整履历 / FIELD CARD ↗</a>
    </div>

    <div class="practice-grid">
      {
        PROJECTS.map((project) => {
          const href = project.postId ? postUrl(project.postId) : withBase('about/');
          return (
            <article class="practice-card">
              <div class="practice-card__top">
                <span class="practice-card__index">{project.index}</span>
                <span>{project.period}</span>
              </div>
              <p class="practice-card__role">{project.role}</p>
              <h3 class="practice-card__title">
                <a href={href}>{project.title}</a>
              </h3>
              <p class="practice-card__summary">{project.summary}</p>
              <dl class="practice-metrics">
                {project.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>
              <div class="practice-card__tags">
                {project.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a class="practice-card__link" href={href}>
                阅读项目复盘 <span aria-hidden="true">↗</span>
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="practice-strip">
      <div class="practice-strip__label mono">INTERNSHIP / 现场训练</div>
      <div class="practice-strip__items">
        {
          INTERNSHIPS.map((internship) => (
            <p>
              <span>{internship.period}</span>
              <strong>{internship.company}</strong>
              <em>{internship.role}</em>
            </p>
          ))
        }
      </div>
      <a class="practice-strip__link" href={withBase('about/')}>查看全部经历 →</a>
    </div>
  </section>

  <section class="notes-section" id="notes" aria-labelledby="notes-title">
    <div class="section-heading">
      <span class="section-heading__index">02 / RECENT FIELD NOTES</span>
      <h2 class="section-heading__title" id="notes-title">最近的现场笔记</h2>
      <a class="section-heading__link" href={withBase('archive/')}>全部归档 / ALL NOTES ↗</a>
    </div>

    {
      latest.length > 0 ? (
        <ol class="note-list">
          {latest.map((post, index) => (
            <PostRow post={post} index={index} />
          ))}
        </ol>
      ) : (
        <p>第一篇文章正在路上。</p>
      )
    }

    <div class="notes-section__footer">
      <a class="text-link" href={withBase('archive/')}>
        查看全部 {posts.length} 篇笔记
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="now-section" aria-labelledby="now-title">
    <div class="now-section__inner">
      <div class="now-section__left">
        <p class="now-section__kicker">NOW / {monthLabel}</p>
        <h2 class="now-section__quote" id="now-title">
          把目标拆开，<br />
          把<em>现场</em>走完。
        </h2>
        <p class="now-section__note">
          正在推进“青衿薪火”的常态化宣讲，也继续跟进“稻香商链”的助农项目。
          同时，我在寻找财务、行政与运营方向的实习和校招机会。
        </p>
        <div class="now-section__cta">
          <a class="button" href={withBase('about/')}>
            完整履历
            <span class="button__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="now-list">
        <div class="now-list__item">
          <span class="now-list__label">在做<br />BUILDING</span>
          <p class="now-list__value">“青衿薪火”红色宣讲项目 · 主要负责人</p>
        </div>
        <div class="now-list__item">
          <span class="now-list__label">在跟进<br />PROJECT</span>
          <p class="now-list__value">“稻香商链·智惠凤山”双产助农项目 · 学生负责人</p>
        </div>
        <div class="now-list__item">
          <span class="now-list__label">在组织<br />LEADING</span>
          <p class="now-list__value">{LEADERSHIP.organization} · 主席（2025.09—2026.06）</p>
        </div>
        <div class="now-list__item">
          <span class="now-list__label">方向<br />NEXT</span>
          <p class="now-list__value">
            财务 / 行政 / 运营 · 2027 届
            <br />
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <br />
            <a href={SITE.github} rel="noopener noreferrer" target="_blank">GitHub ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
