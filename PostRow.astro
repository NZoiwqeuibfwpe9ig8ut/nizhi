---
import { assetUrl, postUrl } from '../lib/urls';
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  index: number;
}

const { post, index } = Astro.props;
const cover = assetUrl(post.data.cover ?? 'covers/default.svg');
const alt = post.data.coverAlt ?? `${post.data.title} 的抽象封面`;
const date = new Date(post.data.date);
const number = String(index + 1).padStart(2, '0');
---

<li class="note-row">
  <a class="note-row__link" href={postUrl(post.id)}>
    <span class="note-row__number" aria-hidden="true">{number}</span>

    <div class="note-row__body">
      <div class="note-row__meta">
        <time datetime={date.toISOString()}>{formatDate(date, 'short')}</time>
        <span class="signal-dot" aria-hidden="true"></span>
        {
          post.data.tags.slice(0, 2).map((tag, tagIndex) => (
            <>
              {tagIndex > 0 && <span aria-hidden="true">/</span>}
              <span>{tag}</span>
            </>
          ))
        }
      </div>
      <h3 class="note-row__title">{post.data.title}</h3>
      <p class="note-row__excerpt">{post.data.excerpt}</p>
      <div class="note-row__tags" aria-label="标签">
        {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    <figure class="note-row__cover">
      {cover && <img src={cover} alt={alt} width="380" height="238" decoding="async" />}
    </figure>

    <span class="note-row__arrow" aria-hidden="true">↗</span>
  </a>
</li>
